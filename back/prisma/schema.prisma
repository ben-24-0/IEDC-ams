generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  SCHEDULED
  ACTIVE
  CLOSED
}

enum MeetingStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions Session[]
  meetings Meeting[]
}

model Student {
  id           String   @id @default(uuid())

  name         String
  role         String?
  team         String?

  rfidUid      String?  @unique

  // Login credentials (assigned after approval)
  username     String?  @unique
  passwordHash String?

  isApproved   Boolean  @default(false)
  isActive     Boolean  @default(true)
  isAdmin      Boolean  @default(false)

  logs          AttendanceLog[]
  dutyLeaveRequests DutyLeaveRequest[]

  createdAt     DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PendingRegistration {
  id           String   @id @default(uuid())

  name         String
  username     String   @unique
  passwordHash String

  createdAt    DateTime @default(now())
}

model Session {
  id                   String         @id @default(uuid())

  title                String
  scheduledTime        DateTime?
  venue                String?

  status               SessionStatus  @default(SCHEDULED)

  agenda               String?

  notificationChannel  String?
  notificationTarget   String?

  confirmedAt          DateTime?

  minutes              String?
  dutyLeaveDocUrl      String?
  dutyLeaveDocUploadedAt DateTime?

  createdBy            AdminUser      @relation(fields: [createdById], references: [id])
  createdById          String

  logs                 AttendanceLog[]
  dutyLeaveRequests    DutyLeaveRequest[]

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Meeting {
  id                   String         @id @default(uuid())

  title                String
  scheduledAt          DateTime
  venue                String

  agenda               String?

  status               MeetingStatus  @default(DRAFT)

  notificationChannel  String?
  notificationTarget   String?

  confirmedAt          DateTime?

  createdBy            AdminUser      @relation(fields: [createdById], references: [id])
  createdById          String

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model AttendanceLog {
  id          String    @id @default(uuid())

  student     Student   @relation(fields: [studentId], references: [id])
  studentId   String

  session     Session   @relation(fields: [sessionId], references: [id])
  sessionId   String

  scannedAt   DateTime  @default(now())

  isManual    Boolean   @default(false)

  modifiedBy  String?
  modifiedAt  DateTime?

  @@unique([studentId, sessionId])
}

model DutyLeaveRequest {
  id          String   @id @default(uuid())

  session     Session  @relation(fields: [sessionId], references: [id])
  sessionId   String

  student     Student  @relation(fields: [studentId], references: [id])
  studentId   String

  requestedAt DateTime @default(now())

  @@unique([sessionId, studentId])
}